{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "sqDoc",
  "patterns": [
    {
      "match": "(#|//).*",
      "captures": {
        "0": {
          "name": "comment.line.squirrel"
        },
        "1": {
          "name": "punctuation.definition.comment.squirrel"
        }
      }
    },
    {
      "begin": "^\\s*(\")",
      "beginCaptures": {
        "1": {
          "name": "string.quoted.double punctuation.definition.string.begin.squirrel"
        }
      },
      "end": "\"|\n",
      "endCaptures": {
        "0": {
          "name": "string.quoted.double string.punctuation.definition.string.end.squirrel"
        }
      },
      "contentName": "string.quoted.double variable.other.squirrel",
      "patterns": [
        {
          "include": "#string-name-escape-sequences"
        }
      ]
    },
    {
      "match": "(?<![_A-Za-z])(function)\\s+(\\w+)\\b",
      "captures": {
        "1": {
          "name": "storage.type.function.squirrel"
        },
        "2": {
          "name": "entity.name.function.squirrel"
        }
      }
    },
    {
      "begin": "(?<![_A-Za-z])(function)\\s+(\")",
      "beginCaptures": {
        "1": {
          "name": "storage.type.function.squirrel"
        },
        "2": {
          "name": "string.quoted.double punctuation.definition.string.begin.squirrel"
        }
      },
      "end": "\"|\n",
      "endCaptures": {
        "0": {
          "name": "string.quoted.double string.punctuation.definition.string.end.squirrel"
        }
      },
      "contentName": "string.quoted.double entity.name.function.squirrel",
      "patterns": [
        {
          "include": "#string-name-escape-sequences"
        }
      ]
    },
    {
      "match": "(?<![_A-Za-z])(class)\\s+(\\w+)\\b",
      "captures": {
        "1": {
          "name": "storage.type.class.squirrel"
        },
        "2": {
          "name": "entity.name.class.squirrel"
        }
      }
    },
    {
      "begin": "(?<![_A-Za-z])(class)\\s+(\")",
      "beginCaptures": {
        "1": {
          "name": "storage.type.class.squirrel"
        },
        "2": {
          "name": "string.quoted.double punctuation.definition.string.begin.squirrel"
        }
      },
      "end": "\"|\n",
      "endCaptures": {
        "0": {
          "name": "string.quoted.double string.punctuation.definition.string.end.squirrel"
        }
      },
      "contentName": "string.quoted.double entity.name.class.squirrel",
      "patterns": [
        {
          "include": "#string-name-escape-sequences"
        }
      ]
    },
    {
      "match": "(?<![_A-Za-z])(enum)\\s+(\\w+)\\b",
      "captures": {
        "1": {
          "name": "storage.type.enum.squirrel"
        },
        "2": {
          "name": "entity.name.type.enum.squirrel"
        }
      }
    },
    {
      "begin": "\"",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin.squirrel"
        }
      },
      "end": "\"|\n",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.squirrel"
        }
      },
      "name": "string.quoted",
      "patterns": [
        {
          "include": "#string-escape-sequences"
        }
      ]
    },
    {
      "name": "constant.numeric.integer.octal.squirrel",
      "match": "0[0-7](\\d*)",
      "captures": {
        "1": {
          "patterns": [
            {
              "name": "invalid.illegal.integer.octal.squirrel",
              "match": "[8-9]"
            }
          ]
        }
      }
    },
    {
      "name": "constant.numeric.integer.hexadecimal.squirrel",
      "match": "0[xX][\\da-fA-F]*"
    },
    {
      "name": "constant.numeric.float.squirrel",
      "match": "\\d+([eE][+-]?|\\.)(\\d|\\.|[eE][+-]?)*",
      "captures": {
        "0": {
          "patterns": [
            {
              "match": "[eE][+-](?!\\d)",
              "name": "invalid.illegal.float.squirrel"
            },
            {
              "match": "[eE](?![+-]?\\d)",
              "name": "invalid.illegal.float.squirrel"
            }
          ]
        }
      }
    },
    {
      "name": "constant.numeric.integer.decimal.squirrel",
      "match": "\\d+"
    },
    {
      "name": "string.quoted.single.squirrel",
      "match": "(\\')(\\\\x\\h{1,2}|\\\\x\\w?|\\\\u\\h{1,4}|\\\\u\\w?|\\\\U\\h{1,8}|\\\\U\\w?|\\\\.|.)?([^']*)(\\'|\n)",
      "captures": {
        "1": {
          "name": "punctuation.definition.string.begin.squirrel"
        },
        "2": {
          "patterns": [
            {
              "include": "#string-escape-sequences"
            }
          ]
        },
        "3": {
          "name": "invalid.illegal.char"
        },
        "4": {
          "name": "punctuation.definition.string.end.squirrel"
        }
      }
    },
    {
      "match": "@(?=\\()",
      "name": "storage.type.function.squirrel"
    },
    {
      "include": "#function-params"
    },
    {
      "match": "->|~>",
      "name": "keyword.operator.arrow.squirrel"
    },
    {
      "match": "!",
      "name": "keyword.operator.throws.squirrel"
    },
    {
      "begin": "(?<=\\??:)(?=\\s*\\S)",
      "end": "(?=[,)\\]\\n]|$)",
      "name": "meta.type.squirrel",
      "patterns": [
        {
          "include": "#doc-type"
        }
      ]
    },
    {
      "begin": "(?<=[~-]>)(?=\\s*\\S)",
      "end": "(?=[,)\\]\\n]|$)",
      "name": "meta.type.squirrel",
      "patterns": [
        {
          "include": "#doc-type"
        }
      ]
    },
    {
      "name": "constant.language.boolean.true.squirrel",
      "match": "(?<![_A-Za-z])true\\b"
    },
    {
      "name": "constant.language.boolean.false.squirrel",
      "match": "(?<![_A-Za-z])false\\b"
    },
    {
      "name": "constant.language.null.squirrel",
      "match": "(?<![_A-Za-z])null\\b"
    },
    {
      "match": "(?<![_A-Za-z])(const)(?:\\s+([_A-Za-z]\\w*))?\\b",
      "captures": {
        "1": {
          "name": "storage.modifier.squirrel"
        },
        "2": {
          "name": "variable.other.constant.squirrel"
        }
      }
    },
    {
      "name": "storage.modifier.local.squirrel",
      "match": "(?<![_A-Za-z])local\\b"
    },
    {
      "name": "storage.modifier.static.squirrel",
      "match": "(?<![_A-Za-z])static\\b"
    },
    {
      "name": "variable.other.squirrel",
      "match": "\\w+"
    },
    {
      "match": "\\(|\\)",
      "name": "meta.brace.round.squirrel"
    },
    {
      "name": "punctuation.separator.comma.squirrel",
      "match": ","
    },
    {
      "name": "punctuation.colon.squirrel",
      "match": ":"
    }
  ],
  "repository": {
    "string-name-escape-sequences": {
      "patterns": [
        {
          "match": "\\\\\""
        }
      ]
    },
    "string-escape-sequences": {
      "patterns": [
        {
          "name": "constant.character.escape.squirrel",
          "match": "\\\\x\\h{1,2}"
        },
        {
          "name": "invalid.illegal.escape.squirrel",
          "match": "\\\\x\\w?"
        },
        {
          "name": "constant.character.escape.squirrel",
          "match": "\\\\u\\h{1,4}"
        },
        {
          "name": "invalid.illegal.escape.squirrel",
          "match": "\\\\u\\w?"
        },
        {
          "name": "constant.character.escape.squirrel",
          "match": "\\\\U\\h{1,8}"
        },
        {
          "name": "invalid.illegal.escape.squirrel",
          "match": "\\\\U\\w?"
        },
        {
          "name": "constant.character.escape.squirrel",
          "match": "\\\\[0tabnrvf\"\\\\'`]"
        },
        {
          "name": "invalid.illegal.escape.squirrel",
          "match": "\\\\."
        }
      ]
    },
    "function-params": {
      "begin": "\\(",
      "beginCaptures": {
        "0": {
          "name": "meta.brace.round.squirrel punctuation.definition.parameters.begin.squirrel"
        }
      },
      "end": "\\)",
      "endCaptures": {
        "0": {
          "name": "meta.brace.round.squirrel punctuation.definition.parameters.end.squirrel"
        }
      },
      "name": "meta.parameters.squirrel",
      "patterns": [
        {
          "match": "\\.\\.\\.",
          "name": "punctuation.definition.varargs.squirrel"
        },
        {
          "match": "([A-Za-z_]\\w*|\"(?:\\\\.|[^\"\\\\])*\")(\\?)?\\s*(:)",
          "captures": {
            "1": {
              "name": "variable.parameter.squirrel"
            },
            "2": {
              "name": "keyword.operator.optional.squirrel"
            },
            "3": {
              "name": "punctuation.colon.squirrel"
            }
          }
        },
        {
          "match": ",",
          "name": "punctuation.separator.comma.squirrel"
        },
        {
          "include": "#doc-type"
        }
      ]
    },
    "doc-type": {
      "patterns": [
        {
          "match": "@(?=\\()",
          "name": "storage.type.function.squirrel"
        },
        {
          "include": "#function-params"
        },
        {
          "match": "->|~>",
          "name": "keyword.operator.arrow.squirrel"
        },
        {
          "match": "!",
          "name": "keyword.operator.throws.squirrel"
        },
        {
          "match": "\\|",
          "name": "punctuation.separator.union.squirrel"
        },
        {
          "match": "\\[|\\]",
          "name": "punctuation.definition.array.squirrel"
        },
        {
          "match": "[A-Za-z_]\\w*",
          "name": "support.type.squirrel"
        }
      ]
    }
  },
  "scopeName": "source.sqDoc"
}